{
  "name": "web-agent-manager",
  "productName": "web-agent-manager",
  "desktopName": "web-agent-manager.desktop",
  "description": "Claude와 Codex 세션을 함께 관리하는 로컬 에이전트 작업 공간",
  "author": {
    "name": "ljy1348",
    "email": "ljy1348@users.noreply.github.com"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ljy1348/web-agent-manager.git"
  },
  "bugs": {
    "url": "https://github.com/ljy1348/web-agent-manager/issues"
  },
  "homepage": "https://github.com/ljy1348/web-agent-manager#readme",
  "version": "0.7.0",
  "private": true,
  "type": "module",
  "bin": {
    "web-agent-manager-worker": "dist/server/scripts/web-agent-manager-worker.js"
  },
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "CHOKIDAR_USEPOLLING=true CHOKIDAR_INTERVAL=300 tsx watch src/server/index.ts",
    "build": "cross-env NODE_ENV=production vite build && cross-env NODE_ENV=production tsup src/server/index.ts scripts/create-admin.ts scripts/create-test-user.ts scripts/create-full-backup.ts scripts/check-deployment-readiness.ts scripts/drill-deployment.ts scripts/run-approved-deployment.ts scripts/restore-full-backup.ts scripts/drill-full-backup.ts scripts/claude-permission-bridge.ts scripts/hook-event-bridge.ts scripts/install-agent-integrations.ts scripts/web-agent-manager-agent.ts scripts/web-agent-manager-worker.ts scripts/myagent-agent.ts --format esm --out-dir dist/server --sourcemap --clean && cross-env NODE_ENV=production tsup scripts/codex-app-server-canary.ts --format esm --out-dir dist/canary --sourcemap --clean --splitting false && node scripts/check-public-build.mjs",
    "release:package": "npm run build && tsx scripts/package-release.ts",
    "desktop": "electron .",
    "desktop:package": "npm run build && electron-builder --publish never",
    "start": "NODE_ENV=production node dist/server/src/server/index.js",
    "admin:create": "node dist/server/scripts/create-admin.js",
    "admin:create:dev": "tsx scripts/create-admin.ts",
    "tester:create": "node dist/server/scripts/create-test-user.js",
    "tester:create:dev": "tsx scripts/create-test-user.ts",
    "canary:codex:dev": "tsx scripts/codex-app-server-canary.ts",
    "deploy:check": "node dist/server/scripts/check-deployment-readiness.js",
    "deploy:check:dev": "tsx scripts/check-deployment-readiness.ts",
    "deploy:drill": "node dist/server/scripts/drill-deployment.js",
    "deploy:drill:dev": "tsx scripts/drill-deployment.ts",
    "deploy:apply-approved": "node dist/server/scripts/run-approved-deployment.js",
    "backup:create": "node dist/server/scripts/create-full-backup.js",
    "backup:create:dev": "tsx scripts/create-full-backup.ts",
    "backup:restore": "node dist/server/scripts/restore-full-backup.js",
    "backup:restore:dev": "tsx scripts/restore-full-backup.ts",
    "backup:drill": "node dist/server/scripts/drill-full-backup.js",
    "backup:drill:dev": "tsx scripts/drill-full-backup.ts",
    "agent": "node dist/server/scripts/web-agent-manager-agent.js",
    "agent:dev": "tsx scripts/web-agent-manager-agent.ts",
    "worker": "node dist/server/scripts/web-agent-manager-worker.js",
    "worker:dev": "tsx scripts/web-agent-manager-worker.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "verify": "npm run typecheck && npm run test && npm run build",
    "test:tui": "tsx scripts/check-usage-tui.ts",
    "test:ui": "playwright test",
    "test:resources": "tsx scripts/check-browser-resources.ts",
    "test:lifecycle": "tsx scripts/check-session-lifecycle.ts",
    "audit:chats": "tsx scripts/audit-chat-bindings.ts"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "dependencies": {
    "@tanstack/react-virtual": "^3.14.9",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/headless": "^6.0.0",
    "@xterm/xterm": "^6.0.0",
    "archiver": "^8.0.0",
    "axe-core": "^4.13.0",
    "better-sqlite3": "^12.11.1",
    "busboy": "^1.6.0",
    "express": "^5.2.1",
    "google-auth-library": "^11.0.0",
    "lucide-react": "^1.28.0",
    "node-pty": "^1.1.0",
    "pixelmatch": "^7.2.0",
    "playwright-core": "^1.62.1",
    "pngjs": "^7.0.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "shiki": "^4.4.2",
    "systeminformation": "^5.33.1",
    "undici": "^7.29.0",
    "ws": "^8.21.2"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/archiver": "^8.0.0",
    "@types/better-sqlite3": "^7.6.13",
    "@types/busboy": "^1.5.4",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.2",
    "@types/pngjs": "^6.0.5",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^6.1.1",
    "cross-env": "^10.1.0",
    "electron": "^43.2.0",
    "electron-builder": "^26.15.3",
    "tsup": "^8.5.1",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "vite": "^8.3.0",
    "vitest": "^4.1.10"
  },
  "overrides": {
    "esbuild": "0.28.1",
    "brace-expansion": "5.0.9"
  },
  "build": {
    "appId": "com.webagentmanager.desktop",
    "productName": "web-agent-manager",
    "executableName": "web-agent-manager",
    "asar": true,
    "asarUnpack": [
      "dist/**/*",
      "skills/**/*",
      "node_modules/**/*",
      "package.json"
    ],
    "npmRebuild": false,
    "files": [
      "electron/**/*",
      "dist/**/*",
      "skills/**/*",
      "package.json"
    ],
    "directories": {
      "output": "release/desktop"
    },
    "linux": {
      "syncDesktopName": true,
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Development"
    },
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.developer-tools"
    },
    "win": {
      "target": [
        "nsis",
        "portable"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
