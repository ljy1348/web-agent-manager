WEB_AGENT_MANAGER_PORT=4317
WEB_AGENT_MANAGER_HOST=127.0.0.1
WEB_AGENT_MANAGER_DATA_DIR=./data
# GitHub 저장소 clone 기본 경로(미설정 시 서비스 계정의 ~/Projects).
WEB_AGENT_MANAGER_PROJECTS_DIR=
# 비워두면 어떤 경로든 프로젝트로 등록 가능(관리자 전용 기능이라 별도 화이트리스트 관리가 필요 없다).
# 특정 디렉터리로만 제한하고 싶을 때만 쉼표로 구분해 명시한다(예: /srv/projects,/workspace).
WEB_AGENT_MANAGER_ALLOWED_ROOTS=
WEB_AGENT_MANAGER_PUBLIC_URL=http://127.0.0.1:4317
# 내부망으로 인정할 대역을 쉼표로 구분해 지정한다(미설정 시 loopback·RFC1918·CGNAT 100.64/10·IPv6 ULA/link-local).
# 내부망 접속은 파일 탭에서 .env·.git 등 민감 경로까지 열람·다운로드할 수 있으므로 좁게 유지한다.
WEB_AGENT_MANAGER_TRUSTED_NETWORKS=
# reverse proxy를 쓸 때 프록시 자체 주소만 쉼표로 구분해 지정한다(예: 127.0.0.1,172.17.0.1).
# 미설정 시 X-Forwarded-For 등 전달 헤더가 붙은 요청은 실제 출처를 알 수 없어 내부망으로 보지 않는다
# (도메인 접속 = 외부망, 사설 IP 직접 접속만 내부망). 지정하면 프록시가 전달한 실제 방문자 주소로 판정하며,
# 실제 프록시보다 넓게 잡으면 X-Forwarded-For 위조로 내부망 판정을 빼앗길 수 있으니 주소를 정확히 적는다.
WEB_AGENT_MANAGER_TRUSTED_PROXIES=
# Vite 개발 서버에서 추가로 허용할 호스트를 쉼표로 구분한다(예: dev.example.com,.example.net).
WEB_AGENT_MANAGER_DEV_ALLOWED_HOSTS=
SLACK_BOT_TOKEN=
SLACK_USER_TOKEN=
SLACK_CHANNEL_ID=
NTFY_TOPIC=
NTFY_SERVER_URL=
# Android 앱 FCM 전송. 1로 켠 뒤 GOOGLE_APPLICATION_CREDENTIALS는 서비스 실행 환경에서만 관리한다.
# 자격증명 파일은 저장소나 APK에 넣지 않는다. 다른 Firebase 프로젝트로 보낼 때만 project id를 지정한다.
WEB_AGENT_MANAGER_FCM_ENABLED=0
WEB_AGENT_MANAGER_FCM_PROJECT_ID=
WEB_AGENT_MANAGER_SESSION_TTL_HOURS=168
# HTTP/WebSocket 활동이 없는 세션 만료(5~10080분), 중요 작업 재인증 유효 창(1~60분)
WEB_AGENT_MANAGER_SESSION_IDLE_MINUTES=720
WEB_AGENT_MANAGER_REAUTH_WINDOW_MINUTES=15
# production 외부 HTTP는 기본 기동 차단. 긴급 임시 우회만 1(대시보드 경고는 유지)
WEB_AGENT_MANAGER_ALLOW_INSECURE_HTTP=0
WEB_AGENT_MANAGER_DISABLE_RUNTIME=0
# Codex app-server read-only status/turn-history shadow. 기본 off이며 운영 실행 경로를 바꾸지 않는다.
WEB_AGENT_MANAGER_CODEX_APP_SERVER_SHADOW=0
# 두 shadow gate 통과 뒤 제한 cohort의 신규 Codex 채팅만 구조화 transport에 배정하는 opt-in.
# flag만 켜서는 동작하지 않고 아래 cohort와 1~20 quota가 모두 필요하다.
WEB_AGENT_MANAGER_CODEX_INTERACTIVE_TRANSPORT_CANDIDATE=0
# 구조화 transport는 cohort 이름과 1~20 quota가 둘 다 있어야 신규 Codex 채팅을 소유합니다.
WEB_AGENT_MANAGER_CODEX_INTERACTIVE_TRANSPORT_COHORT=
WEB_AGENT_MANAGER_CODEX_INTERACTIVE_TRANSPORT_MAX_NEW_CHATS=0
# 선택적 provider CLI canary/단계 rollout. harness root에는 공급자 이름(codex/claude/grok)의 소유자 전용
# 실행 파일을 두고, credential root의 같은 공급자 하위 폴더 내용은 매 run의 임시 HOME에만 복제한다.
# candidate root에는 canary와 신규 채팅 단계 배포가 함께 사용할 공급자 이름의 고정 실행 파일을 둔다.
# Codex용 self-contained harness는 npm run build 후 dist/canary/codex-app-server-canary.js에 생성된다.
# 이를 harness root의 실행 파일 `codex`로 0700 복사하고 운영 계정과 분리된 credential seed만 사용한다.
WEB_AGENT_MANAGER_PROVIDER_CANARY_HARNESS_DIR=
WEB_AGENT_MANAGER_PROVIDER_CANARY_CREDENTIALS_DIR=
WEB_AGENT_MANAGER_PROVIDER_CANDIDATE_CLI_DIR=
# 로그 최소 레벨: debug | info | warn | error (기본값: 운영 info, 그 외 debug)
WEB_AGENT_MANAGER_LOG_LEVEL=
# Optional Chrome/Chromium executable used for loopback live-preview evidence capture.
# WEB_AGENT_MANAGER_PREVIEW_BROWSER_EXECUTABLE=/usr/bin/google-chrome
# 고정 host-key·전용 key 기반 remote worker probe에 사용할 OpenSSH 실행 파일
# WEB_AGENT_MANAGER_SSH_EXECUTABLE=/usr/bin/ssh
