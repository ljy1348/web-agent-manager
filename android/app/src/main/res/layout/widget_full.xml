<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background"
    android:orientation="vertical">

    <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:orientation="horizontal">
        <LinearLayout android:layout_width="0dp" android:layout_height="match_parent" android:layout_marginRight="4dp" android:layout_weight="1" android:background="@drawable/widget_card" android:gravity="center_vertical" android:orientation="vertical">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Claude" android:textColor="#FFB8FF63" android:textSize="11sp" android:textStyle="bold" />
            <TextView android:id="@+id/claude_value" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="#FFFFFFFF" android:textSize="18sp" android:textStyle="bold" />
            <ProgressBar android:id="@+id/claude_progress" style="?android:attr/progressBarStyleHorizontal" android:layout_width="match_parent" android:layout_height="5dp" android:progressTint="#FF7C6FF2" />
        </LinearLayout>
        <LinearLayout android:layout_width="0dp" android:layout_height="match_parent" android:layout_marginLeft="4dp" android:layout_weight="1" android:background="@drawable/widget_card" android:gravity="center_vertical" android:orientation="vertical">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Codex" android:textColor="#FFB8FF63" android:textSize="11sp" android:textStyle="bold" />
            <TextView android:id="@+id/codex_value" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="#FFFFFFFF" android:textSize="18sp" android:textStyle="bold" />
            <ProgressBar android:id="@+id/codex_progress" style="?android:attr/progressBarStyleHorizontal" android:layout_width="match_parent" android:layout_height="5dp" android:progressTint="#FF7C6FF2" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_marginTop="8dp" android:layout_weight="1" android:orientation="horizontal">
        <LinearLayout android:layout_width="0dp" android:layout_height="match_parent" android:layout_marginRight="4dp" android:layout_weight="1" android:background="@drawable/widget_card" android:gravity="center_vertical" android:orientation="vertical">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="CPU" android:textColor="#FFCBD5E1" android:textSize="10sp" android:textStyle="bold" />
            <TextView android:id="@+id/cpu_value" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="#FFFFFFFF" android:textSize="16sp" android:textStyle="bold" />
            <ProgressBar android:id="@+id/cpu_progress" style="?android:attr/progressBarStyleHorizontal" android:layout_width="match_parent" android:layout_height="4dp" android:progressTint="#FFB8FF63" />
        </LinearLayout>
        <LinearLayout android:layout_width="0dp" android:layout_height="match_parent" android:layout_marginLeft="4dp" android:layout_weight="1" android:background="@drawable/widget_card" android:gravity="center_vertical" android:orientation="vertical">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="RAM" android:textColor="#FFCBD5E1" android:textSize="10sp" android:textStyle="bold" />
            <TextView android:id="@+id/memory_value" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="#FFFFFFFF" android:textSize="16sp" android:textStyle="bold" />
            <ProgressBar android:id="@+id/memory_progress" style="?android:attr/progressBarStyleHorizontal" android:layout_width="match_parent" android:layout_height="4dp" android:progressTint="#FFB8FF63" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout android:layout_width="match_parent" android:layout_height="20dp" android:gravity="center_vertical" android:orientation="horizontal">
        <TextView android:id="@+id/widget_status" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:ellipsize="end" android:maxLines="1" android:textColor="#FF9CA3AF" android:textSize="8sp" />
        <TextView android:id="@+id/widget_refresh" android:layout_width="24dp" android:layout_height="match_parent" android:contentDescription="@string/refresh" android:gravity="center" android:text="↻" android:textColor="#FFB8FF63" android:textSize="14sp" />
    </LinearLayout>
</LinearLayout>
