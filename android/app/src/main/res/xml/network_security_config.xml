<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- 사설 IP 평문 접속이 필요해 플랫폼 cleartext는 연다. CIDR 예외를 XML로 적을 수 없다. 공개망 HTTP는 ServerConfig가 거부하며 인증서 검증은 우회하지 않는다. -->
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
